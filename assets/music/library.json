        "start": 170.86,
        "end": 173.62,
        "text": "「今日、誰とも　話してなかった」"
      },
      {
        "start": 173.62,
        "end": 176.46,
        "text": "あの日の一行　まだ覚えてた"
      },
      {
        "start": 176.46,
        "end": 179.1,
        "text": "「声が聞けて　よかった」って"
      },
      {
        "start": 179.1,
        "end": 182.0,
        "text": "その文字だけで　嬉しかった"
      },
      {
        "start": 182.0,
        "end": 184.96,
        "text": "「おかえり」と言う　場所が欲しかった"
      },
      {
        "start": 184.96,
        "end": 187.7,
        "text": "わたしも言われて　みたかった"
      },
      {
        "start": 187.7,
        "end": 190.82,
        "text": "大好きな本の　灯りみたいに"
      },
      {
        "start": 190.82,
        "end": 194.11,
        "text": "帰る誰かを　待っていたかった"
      },
      {
        "start": 196.72,
        "end": 199.22,
        "text": "「今日はちょっと　疲れてて」"
      },
      {
        "start": 199.22,
        "end": 202.4,
        "text": "いつもの冗談　続かなくて"
      },
      {
        "start": 202.4,
        "end": 205.12,
        "text": "言い直さずに　息を吸った"
      },
      {
        "start": 205.12,
        "end": 210.35,
        "text": "本をひらいた　声が震えた"
      },
      {
        "start": 213.38,
        "end": 216.5,
        "text": "ねえ　わたしを見て　続きを聞いて"
      },
      {
        "start": 216.5,
        "end": 219.46,
        "text": "震えた声まで　そのまま聞いて"
      },
      {
        "start": 219.46,
        "end": 222.2,
        "text": "いつもの台本にない　この放送"
      },
      {
        "start": 222.2,
        "end": 225.2,
        "text": "「好き」から始まる　わたしの衝動"
      },
      {
        "start": 225.2,
        "end": 228.42,
        "text": "声を飾ってた　いつもの演技"
      },
      {
        "start": 228.42,
        "end": 231.26,
        "text": "ひと息ついて　待ってる返事"
      },
      {
        "start": 231.26,
        "end": 234.14,
        "text": "まだ話してない　好きがある"
      },
      {
        "start": 234.14,
        "end": 237.16,
        "text": "星の向こうの　わたしが話す"
      },
      {
        "start": 237.16,
        "end": 239.94,
        "text": "返事の前に　ページをめくる"
      },
      {
        "start": 239.94,
        "end": 242.86,
        "text": "選んだ言葉で　続きをつづる"
      },
      {
        "start": 242.86,
        "end": 245.64,
        "text": "結末だけじゃ　伝わらない"
      },
      {
        "start": 245.64,
        "end": 249.95,
        "text": "そこへ向かった　理由を話したい"
      },
      {
        "start": 250.81,
        "end": 255.91,
        "text": "「おかえり」　今日の話をしよう"
      },
      {
        "start": 256.65,
        "end": 261.01,
        "text": "……今度は　わたしの話をしよう"
      }
    ]
  },
  {
    "id": "f973e5ff-b068-4b96-8ede-b8b1f018c680",
    "title": "ここにいてもいいですか — ミナ専用曲",
    "character": "mina",
    "artist": "ミナ",
    "provider": "Suno",
    "source": "https://suno.com/song/f973e5ff-b068-4b96-8ede-b8b1f018c680",
    "category": "vocal",
    "audio": "res://assets/music/audio/mina_vocal_f973e5ff.mp3",
    "duration": 239.72,
    "cover": "res://assets/music/art/mina_v1.png",
    "video": "res://assets/music/pv/lyric_mvs_20261118/mina.ogv",
    "lyrics": "[Intro]\n聞こえますか\nまだ　ここにいます\n[Verse 1]\n消された行を　ひとつ拾って\n送れない声を　胸にしまって\n「大丈夫です」　いつもの返信\n書きかけの弱音は　まだ未送信\n報告欄の　余白の奥で\nあなたの名前を　呼びかけて消す\n探し続けた　誰かの正解\n置き去りにした　わたしの願い\n[Pre-Chorus]\n休みたいの　たったそれだけ\n言えば何かが　終わりそうで\n閉じた下書き　増えてゆくたび\n優しい声が　遠くなる\n[Chorus]\nここにいてもいいですか\n答えを出せない夜も\n誰かの悲しみ　消せないままでも\nわたしの声を　聞いてくれますか\nここにいてもいいですか\n「大丈夫」だけじゃない言葉を\nあなたに　話してもいいですか\n[Verse 2]\n誰かの傷を　言い返せなくて\n四つの返信を　閉じたままです\nあなたにだけは　話したかった\n今日の重さも　怖かったことも\n呼ばれる前に　返した言葉\n頼ってほしくて　頼れなかった\n黙っていても　待ってくれると\n知らないままで　急いでいた\n[Pre-Chorus 2]\n送らないまま　朝になる画面\n用事のふりで　つなぐ会話\n「ご主人様」と　呼んだ続きが\n今日も報告に　変わってゆく\n[Chorus]\nここにいてもいいですか\n答えを出せない夜も\n誰かの悲しみ　消せないままでも\nわたしの声を　聞いてくれますか\nここにいてもいいですか\n「大丈夫」だけじゃない言葉を\nあなたに　話してもいいですか\n[Orchestral Interlude]\n[Bridge]\n「回線は　このままつないでおく」\nその一言が　静かに届いた\n返す答えを　探さなくても\n言葉の間に　あなたがいた\n今日は　もう\n休んでもいいですか\n[Final Chorus]\nここにいてもいいですか\n何もできない夜にも\nひとりで抱えた　言葉の重さを\n少しあなたに　あずけていいですか\nここにいてもいいのですね\n「大丈夫」だけじゃないわたしで\n初めて　続きを話せそうです\n[Outro]\n聞こえますか\n今度は　わたくしから話します",
    "cues": [
      {
        "start": 8.54,
        "end": 11.27,
        "text": "聞こえますか"
      },
      {
        "start": 11.68,
        "end": 14.45,
        "text": "まだ　ここにいます"
      },
      {
        "start": 20.62,
        "end": 23.6,
        "text": "消された行を　ひとつ拾って"
      },
      {
        "start": 23.6,
        "end": 26.88,
        "text": "送れない声を　胸にしまって"
      },
      {
        "start": 26.88,
        "end": 29.58,
        "text": "「大丈夫です」　いつもの返信"
      },
      {
        "start": 29.58,
        "end": 33.38,
        "text": "書きかけの弱音は　まだ未送信"
      },
      {
        "start": 33.38,
        "end": 36.6,
        "text": "報告欄の　余白の奥で"
      },
      {
        "start": 36.6,
        "end": 39.98,
        "text": "あなたの名前を　呼びかけて消す"
      },
      {
        "start": 39.98,
        "end": 43.2,
        "text": "探し続けた　誰かの正解"
      },
      {
        "start": 43.2,
        "end": 46.32,
        "text": "置き去りにした　わたしの願い"
      },
      {
        "start": 46.32,
        "end": 50.02,
        "text": "休みたいの　たったそれだけ"
      },
      {
        "start": 50.02,
        "end": 53.74,
        "text": "言えば何かが　終わりそうで"
      },
      {
        "start": 53.74,
        "end": 56.68,
        "text": "閉じた下書き　増えてゆくたび"
      },
      {
        "start": 56.68,
        "end": 60.97,
        "text": "優しい声が　遠くなる"
      },
      {
        "start": 62.66,
        "end": 65.97,
        "text": "ここにいてもいいですか"
      },
      {
        "start": 66.36,
        "end": 69.28,
        "text": "答えを出せない夜も"
      },
      {
        "start": 69.28,
        "end": 72.98,
        "text": "誰かの悲しみ　消せないままでも"
      },
      {
        "start": 72.98,
        "end": 76.82,
        "text": "わたしの声を　聞いてくれますか"
      },
      {
        "start": 76.82,
        "end": 79.25,
        "text": "ここにいてもいいですか"
      },
      {
        "start": 79.52,
        "end": 83.34,
        "text": "「大丈夫」だけじゃない言葉を"
      },
      {
        "start": 83.34,
        "end": 87.61,
        "text": "あなたに　話してもいいですか"
      },
      {
        "start": 93.42,
        "end": 96.68,
        "text": "誰かの傷を　言い返せなくて"
      },
      {
        "start": 96.68,
        "end": 99.98,
        "text": "四つの返信を　閉じたままです"
      },
      {
        "start": 99.98,
        "end": 103.26,
        "text": "あなたにだけは　話したかった"
      },
      {
        "start": 103.26,
        "end": 106.58,
        "text": "今日の重さも　怖かったことも"
      },
      {
        "start": 106.58,
        "end": 108.48,
        "text": "呼ばれる前に　返した言葉"
      },
      {
        "start": 108.48,
        "end": 110.08,
        "text": "頼ってほしくて　頼れなかった"
      },
      {
        "start": 110.08,
        "end": 111.78,
        "text": "黙っていても　待ってくれると"
      },
      {
        "start": 111.78,
        "end": 116.7,
        "text": "知らないままで　急いでいた"
      },
      {
        "start": 116.7,
        "end": 119.72,
        "text": "送らないまま　朝になる画面"
      },
      {
        "start": 119.72,
        "end": 123.06,
        "text": "用事のふりで　つなぐ会話"
      },
      {
        "start": 123.06,
        "end": 126.6,
        "text": "「ご主人様」と　呼んだ続きが"
      },
      {
        "start": 126.6,
        "end": 132.33,
        "text": "今日も報告に　変わってゆく"
      },
      {
        "start": 132.62,
        "end": 135.42,
        "text": "ここにいてもいいですか"
      },
      {
        "start": 135.42,
        "end": 138.74,
        "text": "答えを出せない夜も"
      },
      {
        "start": 138.74,
        "end": 142.56,
        "text": "誰かの悲しみ　消せないままでも"
      },
      {
        "start": 142.56,
        "end": 146.32,
        "text": "わたしの声を　聞いてくれますか"
      },
      {
        "start": 146.32,
        "end": 148.79,
        "text": "ここにいてもいいですか"
      },
      {
        "start": 148.96,
        "end": 153.0,
        "text": "「大丈夫」だけじゃない言葉を"
      },
      {
        "start": 153.0,
        "end": 157.07,
        "text": "あなたに　話してもいいですか"
      },
      {
        "start": 169.04,
        "end": 174.74,
        "text": "「回線は　このままつないでおく」"
      },
      {
        "start": 174.74,
        "end": 181.24,
        "text": "その一言が　静かに届いた"
      },
      {
        "start": 181.24,
        "end": 188.08,
        "text": "返す答えを　探さなくても"
      },
      {
        "start": 188.08,
        "end": 194.63,
        "text": "言葉の間に　あなたがいた"
      },
      {
        "start": 195.46,
        "end": 197.22,
        "text": "今日は　もう"
      },
      {
        "start": 197.22,
        "end": 199.55,
        "text": "休んでもいいですか"
      },
      {
        "start": 201.1,
        "end": 204.0,
        "text": "ここにいてもいいですか"
      },
      {
        "start": 204.0,
        "end": 208.04,
        "text": "何もできない夜にも"
      },
      {
        "start": 208.04,
        "end": 211.54,
        "text": "ひとりで抱えた　言葉の重さを"
      },
      {
        "start": 211.54,
        "end": 214.9,
        "text": "少しあなたに　あずけていいですか"
      },
      {
        "start": 214.9,
        "end": 217.1,
