[gd_resource type="AudioBusLayout" load_steps=2 format=3]

; MINA のオーディオバス構成（mitsuda sound-map / implementation §A）。
;   Master ─ Music / SE / Voice / Amb / Alert
;   Music には LowPass を1枚仕込み（汚染ゲージ連動の濁し枠。初期は全開＝透過）。
;   Alert は被弾・残機・段階移行など最優先音を逃がす枠（埋もれ防止）。

[sub_resource type="AudioEffectLowPassFilter" id="LowPass_music"]
cutoff_hz = 20500.0

[resource]
bus/0/name = "Master"
bus/0/solo = false
bus/0/mute = false
bus/0/bypass_fx = false
bus/0/volume_db = 0.0
bus/0/send = "Master"
bus/1/name = "Music"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = 0.0
bus/1/send = "Master"
bus/1/effect/0/effect = SubResource("LowPass_music")
bus/1/effect/0/enabled = true
bus/2/name = "SE"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = 0.0
bus/2/send = "Master"
bus/3/name = "Voice"
bus/3/solo = false
bus/3/mute = false
bus/3/bypass_fx = false
bus/3/volume_db = 0.0
bus/3/send = "Master"
bus/4/name = "Amb"
bus/4/solo = false
bus/4/mute = false
bus/4/bypass_fx = false
bus/4/volume_db = 0.0
bus/4/send = "Master"
bus/5/name = "Alert"
bus/5/solo = false
bus/5/mute = false
bus/5/bypass_fx = false
bus/5/volume_db = 0.0
bus/5/send = "Master"
